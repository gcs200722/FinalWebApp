@model List<FinalWebApp.Data.Entities.ApplicationUser>
<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/Staff/ListCustomer.css" />
</head>
<div class="user-list">
    <h2 class="text-center mb-4">
        List of Users
        <a asp-action="Create" asp-controller="UserManager" class="btn btn-create-new">Create New</a>
    </h2>

    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>Full Name</th>
                <th>Email</th>
                <th>Gender</th>
                <th>Date of Birth</th>
                <th>Phone Number</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Fullname</td>
                    <td>@user.Email</td>
                    <td>@user.Gender</td>
                    <td>@user.DateOfBirth?.ToString("dd/MM/yyyy")</td>
                    <td>@user.NumberPhone</td>
                    <td>
                        <a href="@Url.Action("Edit", "UserManager", new { id = user.Id })" class="btn btn-edit">Edit</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
