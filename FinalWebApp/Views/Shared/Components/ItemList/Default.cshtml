@model List<FinalWebApp.Data.Entities.Item>
<head>
    <link rel="stylesheet" href="~/css/Manager/ManageItem.css" />
</head>
<div class="row">
    <div class="scrollable-table">
        <table>
            <thead>
                <tr>
                    <th width="5%">No.</th>
                    <th width="20%">Name of Item</th>
                    <th width="20%">Description</th>
                    <th width="10%">

                        Category <form method="get">
                            <select name="categoryId" onchange="this.form.submit()" class="form-select form-select-sm">
                                <option value="">-- All Categories --</option>
                                @foreach (var category in ViewBag.Categories)
                                {
                                    <option value="@category.Value" selected="@(category.Value == Context.Request.Query["categoryId"])">
                                        @category.Text
                                    </option>
                                }
                            </select>
                        </form>
                    </th>
                    <th width="10%">Price</th>
                    <th width="20%">Image</th>
                    <th width="15%">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    var position = 1;
                    foreach (var item in Model.OrderByDescending(i => i.Id))
                    {
                        <tr>
                            <td class="text-center">@position</td>
                            <td>@item.Name</td>
                            <td>@item.Description</td>
                            <td>@item.Category.Name</td>
                            <td>@item.Price.ToString("C", new System.Globalization.CultureInfo("vi-VN"))</td>
                            <td>
                                <img src="@Url.Content("~/Image/" + item.Image)" alt="@item.Name" width="100" />
                            </td>
                            <td class="text-center">
                                <a href="~/Item/Edit?idItem=@item.Id" class="btn btn-sm btn-primary">Update</a>
                                @using (Html.BeginForm("Delete", "Item", FormMethod.Post, new { onsubmit = "return confirm('Are you sure you want to delete this item?');" }))
                                {
                                    @Html.Hidden("id", item.Id)
                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                }
                            </td>
                        </tr>
                        position++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center">Empty data</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

