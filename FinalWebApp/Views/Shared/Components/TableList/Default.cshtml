@model List<FinalWebApp.Data.Entities.Table>
<head>
    <link rel="stylesheet" href="~/css/Manager/ManageTable.css" />
</head>

    <div class="table-container">
        <table class="table">
            <thead>
                <tr>
                    <th>Position</th>
                    <th>Name</th>
                    <th>Capacity</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    var position = 1;
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@(position++)</td>
                            <td>@item.Name</td>
                            <td>@item.Capacity</td>
                            <td class="status">@item.Status</td>
                            <td>
                                <!-- Nút Update -->
                                <a href="~/Table/Edit?idTable=@item.Id" class="btn btn-update">
                                    <i class="fa fa-pencil"></i> 
                                </a>

                                <!-- Nút Delete -->
                                @using (Html.BeginForm("Delete", "Table", FormMethod.Post))
                                {
                                    @Html.Hidden("id", item.Id)
                                    <button type="submit" class="btn btn-delete" onclick="return confirm('Are you sure you want to delete this item?');">
                                        <i class="fa fa-trash"></i> 
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">No data available</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

